{
  "name": "solarbloom",
  "private": true,
  "version": "0.1.0",
  "description": "A restoration game: bring a dead park and city back to life.",
  "author": "Solarbloom",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:full": "vitest run --mode full",
    "bot:walk": "vitest run --mode full tests/walk-bot.test.ts",
    "bot:oldcity": "vitest run --mode full tests/oldcity-walkbot.test.ts",
    "test:perf": "PERF=1 vitest run",
    "test:soak": "SOAK=1 vitest run",
    "test:e2e": "vite build && node tests/e2e/picking.e2e.mjs && node tests/e2e/picking-oldcity.e2e.mjs && node tests/e2e/oldcity-drawcalls.e2e.mjs && node tests/e2e/oldcity-camera.e2e.mjs && node tests/e2e/area-panel.e2e.mjs && node tests/e2e/overview.e2e.mjs && node tests/e2e/hud-overlap.e2e.mjs && node tests/e2e/district-bloom.e2e.mjs && node tests/e2e/camera.e2e.mjs",
    "test:perf:browser": "vite build && node tests/perf/browser.perf.mjs",
    "test:leak": "vite build && node tests/perf/leak.perf.mjs",
    "shots:city": "vite build && node tests/e2e/city-shots.mjs && node tests/e2e/oldcity-shots.mjs city && node tests/e2e/oldcity-shots.mjs height",
    "shots:park": "vite build && node tests/e2e/park-shots.mjs && node tests/e2e/oldcity-shots.mjs park",
    "shots:rooftops": "vite build && node tests/e2e/rooftop-shots.mjs",
    "shots:look3": "vite build && node tests/e2e/look3-shots.mjs",
    "shots:roads": "vite build && node tests/e2e/road-shots.mjs",
    "test:hud": "vite build && STRICT=1 node tests/e2e/phase4-hud.e2e.mjs",
    "test:session": "vite build && node tests/e2e/phase4-session.e2e.mjs",
    "shots:phase4": "vite build && node tests/e2e/phase4-shots.mjs && node tests/e2e/phase4-machines.mjs",
    "shots:look": "vite build && node tests/e2e/look-shots.mjs",
    "shots:phase5": "vite build && node tests/e2e/phase5-hud-shots.mjs",
    "test:merge": "vite build && node tests/e2e/merge.e2e.mjs",
    "test:events": "vite build && node tests/e2e/events.e2e.mjs",
    "test:gamepad": "vite build && node tests/e2e/gamepad.e2e.mjs",
    "shots:look2": "vite build && node tests/e2e/look2-shots.mjs",
    "desktop": "vite build && electron . --windowed",
    "package:deck": "vite build && electron-builder --linux AppImage --x64 --publish never",
    "shots:plots": "vite build && node tests/e2e/plot-shots.mjs",
    "shots:decor": "vite build && node tests/e2e/decor-shots.mjs"
  },
  "dependencies": {
    "break_infinity.js": "2.2.0",
    "playcanvas": "^2.23.0"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.solarbloom.game",
    "productName": "Solarbloom",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "Solarbloom-${version}-steamdeck.${ext}"
    }
  }
}
