{
  "name": "solarbloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "PERF=1 vitest run",
    "test:soak": "SOAK=1 vitest run",
    "test:e2e": "vite build && node tests/e2e/picking.e2e.mjs",
    "test:perf:browser": "vite build && node tests/perf/browser.perf.mjs",
    "test:leak": "vite build && node tests/perf/leak.perf.mjs"
  },
  "dependencies": {
    "playcanvas": "^2.23.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
