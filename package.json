{
  "name": "solarbloom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "PERF=1 vitest run",
    "test:soak": "SOAK=1 vitest run",
    "test:e2e": "vite build && node tests/e2e/picking.e2e.mjs && node tests/e2e/area-panel.e2e.mjs && node tests/e2e/overview.e2e.mjs && node tests/e2e/hud-overlap.e2e.mjs && node tests/e2e/district-bloom.e2e.mjs",
    "test:perf:browser": "vite build && node tests/perf/browser.perf.mjs",
    "test:leak": "vite build && node tests/perf/leak.perf.mjs",
    "shots:city": "vite build && node tests/e2e/city-shots.mjs",
    "shots:park": "vite build && node tests/e2e/park-shots.mjs",
    "shots:rooftops": "vite build && node tests/e2e/rooftop-shots.mjs",
    "test:hud": "vite build && STRICT=1 node tests/e2e/phase4-hud.e2e.mjs",
    "test:session": "vite build && node tests/e2e/phase4-session.e2e.mjs",
    "shots:phase4": "vite build && node tests/e2e/phase4-shots.mjs"
  },
  "dependencies": {
    "playcanvas": "^2.23.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
